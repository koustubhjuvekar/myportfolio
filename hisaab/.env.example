# =====================================================================
# HISAAB PRO — ENVIRONMENT VARIABLE CONFIGURATION (.env)
# Copy this file to '.env' and customize the values for your setup.
# =====================================================================

# 1. CORE WEB SERVER SETTINGS
PORT=3000
NODE_ENV="development" # Set to "production" when deploying live
APP_URL="http://localhost:3000"

# 2. DEFAULT ADMINISTRATOR CREDENTIALS (Requested Defaults)
DEFAULT_ADMIN_USERNAME="admin0987654321"
DEFAULT_ADMIN_PASSWORD="admin0987654321"
DEFAULT_ADMIN_EMAIL="admin@hisaabpro.local"
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_PHONE="+91 9876543210"

# 3. DATABASE SELECTION & CONFIGURATION
# Options: "json" | "mysql" | "mongodb"
# Default is "json" (zero-setup file storage in /server/db/hisaab_db.json)
DATABASE_TYPE="json"

# --- Option A: MySQL / MariaDB (phpMyAdmin / XAMPP / AWS RDS / Cloud SQL) ---
# When DATABASE_TYPE="mysql", provide your database credentials below:
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="" # Leave empty for default XAMPP/WAMP, or enter your MySQL root password
MYSQL_DATABASE="hisaab_pro"
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL="false" # Set to "true" for cloud providers (PlanetScale, Supabase, AWS RDS)

# --- Option B: MongoDB (Local MongoDB Compass or MongoDB Atlas Free Tier) ---
# When DATABASE_TYPE="mongodb", provide your MongoDB connection string below:
# Cloud Atlas:
MONGODB_URI="mongodb+srv://hisaab_user:Password123@cluster0.c6hey1w.mongodb.net/hisaab_pro?retryWrites=true&w=majority"

# 4. SECURITY & SESSION TOKEN SETTINGS
# Secret string used to sign session tokens (generate any random 32+ character string)
JWT_SECRET="hisaab_pro_super_secure_secret_key_2026_production_safe"
SESSION_EXPIRY_HOURS="72"

# 5. OTP VERIFICATION SETTINGS
# Mode: "free_simulation" (Default, 100% Free on-screen 6-digit OTP, zero costs)
# Or: "production_sms" (requires paid Twilio/MSG91 gateway)
OTP_MODE="free_simulation"
OTP_EXPIRY_MINUTES="5"

# Optional: Real SMS Gateway (Only if you upgrade to paid SMS in the future)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_PHONE_NUMBER="+1234567890"

# 6. APP BRANDING & DEFAULTS
APP_NAME="Hisaab Pro"
APP_CURRENCY="INR" # INR (₹), USD ($), EUR (€), etc.
APP_LOCALE="en-IN"

# 7. AI STUDIO PLATFORM KEYS (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
